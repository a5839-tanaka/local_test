TARGET_PROC = checkmutex

TARGET = ../obj/$(TARGET_PROC)
OBJ_DIR = ../obj/

SRCS = \
		checkmutex.c

OBJS = \
		$(OBJ_DIR)checkmutex.o

LIBS = 

INCS = \
		../../inc/pvdefine.h \
		../../inc/pvfile.h

CC := gcc
CFLAGS := -lpthread
RM := \rm
CP := \cp -p 

INC_PATH = \
	-I../inc \
	-I../../inc

$(TARGET) : $(OBJS) $(LIBS) $(INCS)
	@echo "======================================================"
	@echo "Target Linking : $(TARGET)"
	@$(CC) $(CFLAGS) $(INC_PATH) -o $(TARGET) $(OBJS) $(LIBS)
	@echo "Target Chmod   : +s"
	@chmod +s $(TARGET)
	@echo "Target Copy to : ../../../tool/$(TARGET_PROC)"
	@$(CP) -p $(TARGET) ../../../tool/$(TARGET_PORC)
	@echo "======================================================"

$(OBJ_DIR)checkmutex.o : checkmutex.c $(INCS)
	@echo "Compile : $<"
	@$(CC) $(CFLAGS) $(INC_PATH) -c $< -o $@

clean :
	@echo "Remove : $(TERGET) $(OBJS)"
	@$(RM) -f $(TARGET) $(OBJS)
