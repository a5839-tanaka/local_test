	@$(CC) $(CFLAGS) $(INC_PATH) -o $(TARGET) $(OBJS) $(LIBS)
	@echo "Target Chmod   : +s"
	@chmod +s $(TARGET)
	@echo "Target Copy to : ../../../tool/$(TARGET_PROC)"
	@$(CP) -p $(TARGET) ../../../tool/$(TARGET_PORC)
	@echo "======================================================"

$(OBJ_DIR)remote_file_change.o : remote_file_change.c $(INCS)
	@echo "Compile : $<"
	@$(CC) $(CFLAGS) $(INC_PATH) -c $< -o $@

clean :
	@echo "Remove : $(TARGET) $(OBJS)"
	@$(RM) -f $(TARGET) $(OBJS)
